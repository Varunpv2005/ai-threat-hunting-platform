# =============================================================================
# .env.example  —  copy to .env before running docker compose
#   cp .env.example .env
# All values shown are the defaults used in docker-compose.yml.
# Never commit the real .env file.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
# Generate a real key: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=socdb
POSTGRES_USER=socuser
POSTGRES_PASSWORD=socpassword
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ── Elasticsearch / Kibana (only used with: docker compose --profile elk up) ──
ES_PORT=9200
KIBANA_PORT=5601

# ── Host ports ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── ML training ────────────────────────────────────────────────────────────────
TRAIN_ON_STARTUP=true
N_TRAIN_EVENTS=5000
WORKERS=2
